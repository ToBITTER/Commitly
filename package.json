{
  "name": "rentsplit-api",
  "version": "1.0.0",
  "description": "Responsive roommate expense-splitting web app with balances, settlements, reminders, and a local API.",
  "type": "module",
  "main": "./src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env ./src/server.js",
    "dev": "node --env-file-if-exists=.env --watch ./src/server.js",
    "test": "node --test",
    "smoke:api": "node ./scripts/smoke-api.js",
    "check:deployment": "node ./scripts/check-deployment.js",
    "verify": "npm test && npm run smoke:api"
  },
  "keywords": [
    "roommates",
    "rent",
    "expense-splitting",
    "backend",
    "api"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "public",
    "src",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "dependencies": {
    "better-auth": "^1.6.25",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0"
  }
}
